    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark": "tsx scripts/benchmark.ts",
    "monitor": "tsx scripts/monitor.ts"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "drizzle-orm": "^0.29.0",
    "drizzle-kit": "^0.20.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "ioredis": "^5.3.0",
    "rate-limiter-flexible": "^4.0.0",
    "zod": "^3.22.0",
    "zustand": "^4.3.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
