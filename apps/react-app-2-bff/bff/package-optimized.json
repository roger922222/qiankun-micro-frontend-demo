{
  "name": "react-app-2-bff-optimized",
  "version": "2.0.0",
  "description": "React商品管理子应用 BFF层 - 优化版（PostgreSQL + Redis + 监控）",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3013",
    "build": "next build",
    "start": "next start -p 3013",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
