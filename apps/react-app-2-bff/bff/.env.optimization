# 优化版BFF环境变量配置
# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_management
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_MAX_CONNECTIONS=20
DB_STATEMENT_TIMEOUT=5000

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAXMEMORY_POLICY=allkeys-lru

# 性能监控配置
PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLING_RATE=0.1
SLOW_QUERY_THRESHOLD=1000
ALERT_RESPONSE_TIME=2000
ALERT_ERROR_RATE=0.05

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_POINTS=100
RATE_LIMIT_GENERAL_DURATION=60
RATE_LIMIT_PRODUCT_LIST_POINTS=200
RATE_LIMIT_PRODUCT_CREATE_POINTS=10
RATE_LIMIT_BATCH_POINTS=5

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL_PRODUCT_LIST=300
CACHE_TTL_PRODUCT_DETAIL=600
CACHE_TTL_PRODUCT_STATS=900
CACHE_TTL_CATEGORY_LIST=1800
CACHE_TTL_SEARCH_RESULTS=180

# 安全配置
SECURITY_MAX_REQUEST_SIZE=10485760  # 10MB
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_IP_REPUTATION_THRESHOLD=30

# 日志配置
LOG_LEVEL=info
LOG_REQUESTS=true
LOG_RESPONSES=true
LOG_ERRORS=true
LOG_PERFORMANCE=true

# 数据库连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# Redis连接池配置
REDIS_POOL_MIN=1
REDIS_POOL_MAX=10
REDIS_POOL_IDLE_TIMEOUT=30000
REDIS_POOL_CONNECTION_TIMEOUT=2000

# 监控和告警
MONITORING_ENABLED=true
METRICS_RETENTION_DAYS=7
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=

# 性能优化
OPTIMIZATION_QUERY_CACHE=true
OPTIMIZATION_CONNECTION_POOLING=true
OPTIMIZATION_BATCH_OPERATIONS=true
OPTIMIZATION_INDEX_USAGE=true

# 开发环境配置
NODE_ENV=development
PORT=3013
CORS_ORIGIN=http://localhost:3012
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With