{
  "name": "@qiankun-demo/react-app-2-fullstack",
  "version": "2.0.0",
  "description": "React App 2 全栈应用 - 前端 + BFF服务",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "npm run preview --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "type-check": "npm run type-check:frontend && npm run type-check:backend",
    "type-check:frontend": "npm run type-check --workspace=frontend",
    "type-check:backend": "npm run type-check --workspace=backend",
    "db:init": "npm run db:init --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "clean": "npm run clean --workspace=frontend && npm run clean --workspace=backend",
    "docker:build": "docker build -t react-app-2-fullstack .",
    "docker:run": "docker run -p 3002:3002 -p 3012:3012 react-app-2-fullstack"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@qiankun-demo/eslint-config": "workspace:*",
    "@qiankun-demo/typescript-config": "workspace:*"
  }
}