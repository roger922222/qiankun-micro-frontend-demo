{
  "name": "@qiankun-demo/react-app-2-backend",
  "version": "2.0.0",
  "description": "React App 2 BFF服务 - Next.js API服务",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:init": "node scripts/init-database.js",
    "db:migrate": "drizzle-kit push:pg",
    "db:generate": "drizzle-kit generate:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-database.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rimraf .next dist",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "drizzle-orm": "^0.29.1",
    "drizzle-kit": "^0.20.6",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@opentelemetry/auto-instrumentations-node": "^0.40.0",
    "@opentelemetry/instrumentation-pg": "^0.36.0",
    "rate-limiter-flexible": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    "@qiankun-demo/shared": "workspace:*"
  },
  "devDependencies": {
    "@qiankun-demo/eslint-config": "workspace:*",
    "@qiankun-demo/typescript-config": "workspace:*",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "@types/redis": "^4.0.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "rimraf": "^5.0.5",
    "@next/bundle-analyzer": "^14.0.4"
  }
}